{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":enableRenovate",
    ":semanticCommits",
    "config:best-practices",
  ],
  timezone: "UTC",
  dependencyDashboard: true,
  platformCommit: "enabled",
  prCreation: "not-pending",
  rebaseWhen: "conflicted",
  suppressNotifications: ["prIgnoreNotification"],
  enabledManagers: ["gradle", "gradle-wrapper", "github-actions", "devcontainer", "nix", "custom.regex"],
  // the nix manager is in beta and disabled by default
  nix: {
    enabled: true,
  },
  customManagers: [
    {
      // headlessmc_version and dev_plugin_headlessmc_version are only read through providers.gradleProperty
      // in the build scripts, so the gradle manager does not see them. The plugins use the
      // io.github.headlesshq:headlessmc-application runner. If dev_plugin_headlessmc_version is a SNAPSHOT
      // of an unreleased HeadlessMc, it is bumped by hand, see the packageRules.
      customType: "regex",
      managerFilePatterns: ["/^gradle\\.properties$/"],
      matchStrings: ["^(?:dev_plugin_)?headlessmc_version=(?<currentValue>\\S+)\\s*$"],
      datasourceTemplate: "maven",
      depNameTemplate: "io.github.headlesshq:headlessmc-application",
    },
  ],
  packageRules: [
    {
      // never update SNAPSHOT versions
      matchCurrentValue: "/-SNAPSHOT$/",
      enabled: false,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["dependency/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["dependency/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["dependency/patch"],
    },
    {
      // dependency updates change the published plugins, so they are fixes (release-please releases them)
      matchManagers: ["gradle", "custom.regex"],
      semanticCommitType: "fix",
      semanticCommitScope: "deps",
    },
    {
      matchManagers: ["gradle-wrapper"],
      semanticCommitType: "build",
      semanticCommitScope: "deps",
    },
    {
      // the flake only provides the dev shell, so its inputs are updated together once a month
      matchManagers: ["nix"],
      groupName: "nix flake inputs",
      schedule: ["on the first day of the month"],
      automerge: false,
      semanticCommitType: "build",
      semanticCommitScope: "deps",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "deps",
    },
    {
      // the devcontainer (added separately) only affects development, not the published plugins
      matchManagers: ["devcontainer"],
      semanticCommitType: "chore",
      semanticCommitScope: "deps",
    },
  ],
}
