{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":enableRenovate",
    ":semanticCommits",
    "config:best-practices",
  ],
  timezone: "Europe/Berlin",
  dependencyDashboard: true,
  platformCommit: "enabled",
  prCreation: "not-pending",
  rebaseWhen: "conflicted",
  suppressNotifications: ["prIgnoreNotification"],
  labels: ["dependency"],
  enabledManagers: ["gradle", "gradle-wrapper", "github-actions", "custom.regex"],
  // dev_plugin_headlessmc_version (3.0.0-RC9-SNAPSHOT) is intentionally not updated: it is a SNAPSHOT of an
  // unreleased HeadlessMc that is bumped by hand. The regex below only matches headlessmc_version, and no
  // build script uses the dev property as a dependency declaration, so Renovate never touches it.
  customManagers: [
    {
      // headlessmc_version is only read through providers.gradleProperty in the build scripts,
      // so the gradle manager does not see it. The plugins use the io.github.headlesshq:headlessmc-application runner.
      customType: "regex",
      managerFilePatterns: ["/^gradle\\.properties$/"],
      matchStrings: ["^headlessmc_version=(?<currentValue>\\S+)\\s*$"],
      datasourceTemplate: "maven",
      depNameTemplate: "io.github.headlesshq:headlessmc-application",
    },
  ],
  packageRules: [
    {
      // never update SNAPSHOT versions
      matchCurrentValue: "/-SNAPSHOT$/",
      enabled: false,
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["patch"],
    },
    {
      // dependency updates change the published plugins, so they are fixes (release-please releases them)
      matchManagers: ["gradle", "custom.regex"],
      semanticCommitType: "fix",
      semanticCommitScope: "deps",
    },
    {
      matchManagers: ["gradle-wrapper"],
      semanticCommitType: "build",
      semanticCommitScope: "deps",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "deps",
    },
  ],
}
